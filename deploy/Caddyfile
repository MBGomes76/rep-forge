{
	frankenphp
}

# SERVER_NAME : le domaine (ex. repforge.duckdns.org). Caddy obtient et renouvelle
# tout seul le certificat HTTPS (Let's Encrypt), et redirige le HTTP vers le HTTPS.
{$SERVER_NAME} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		X-Frame-Options "DENY"
		-Server
	}

	# API Symfony : même domaine que l'app, donc le cookie de session suffit (pas de CORS).
	handle /api/* {
		root * /app/public
		php_server
	}

	# Application (PWA)
	handle {
		root * /srv/web

		# Toujours revalidés : c'est par eux que les téléphones découvrent une nouvelle version.
		@entrypoints path /index.html /sw.js /manifest.webmanifest /registerSW.js
		header @entrypoints Cache-Control "no-cache"

		# Fichiers dont le nom contient une empreinte : ils ne changent jamais.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"

		# Toute adresse de l'app (/seance, /programmes/…) renvoie l'application.
		try_files {path} /index.html
		file_server
	}
}
