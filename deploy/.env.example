# Copier en deploy/.env sur le serveur (jamais commité), puis remplir.
# Mots de passe : lettres et chiffres uniquement, générés par exemple avec
#   openssl rand -hex 24

# Domaine de l'application (ex. repforge.duckdns.org), qui pointe vers l'IP du serveur.
DOMAIN=

# Secret de Symfony (signature des sessions, etc.).
APP_SECRET=

# Super-utilisateur PostgreSQL : sert uniquement au premier démarrage.
POSTGRES_PASSWORD=
# Rôle des migrations (propriétaire du schéma).
DB_ADMIN_PASSWORD=
# Rôle de l'application (lecture et écriture des données).
DB_USER_PASSWORD=
