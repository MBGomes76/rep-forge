<?xml version="1.0" encoding="UTF-8"?>
<!-- Mapping hors du domaine : les classes du domaine restent du PHP pur, sans attributs Doctrine. -->
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="App\Domain\Account\User" table="app_user">
        <id name="id" type="guid"/>
        <field name="email" type="string" length="254" unique="true"/>
        <field name="passwordHash" type="string" length="255"/>
        <field name="createdAt" type="datetimetz_immutable"/>
    </entity>
</doctrine-mapping>
